# =============================================================================
# Horain Backend - Environment variables (for Render / local reference)
# =============================================================================
# Spring Boot reads these from the environment. Render injects them automatically.
# For local dev with PostgreSQL, export these or use a script that loads them.
#
# Where to configure:
#   - Render: Environment tab in your Web Service dashboard
#   - Local:  export before mvn spring-boot:run, or use a loader script
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL - Session Pooler)
# -----------------------------------------------------------------------------
# Render is IPv4-only: use Session Pooler. In Supabase: Method = "Session pooler"
# URL only (no ?user= or ?password=) - use separate vars below
# Where: Render = Environment variables
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Pooler user: postgres.PROJECT_REF (from Supabase JDBC string)
# Where: Render = Environment variables
SPRING_DATASOURCE_USERNAME=postgres.zganzlhymnrdrmryungy

# Your actual Supabase database password (replace [YOUR-PASSWORD])
# Where: Render = Environment variables (add as secret)
SPRING_DATASOURCE_PASSWORD=your_real_password

# -----------------------------------------------------------------------------
# Spring profile
# -----------------------------------------------------------------------------
# Use postgres profile in production (uses PostgreSQL dialect and config)
# Where: Render = Environment variables
SPRING_PROFILES_ACTIVE=postgres

# -----------------------------------------------------------------------------
# HORAIN_API_KEY
# -----------------------------------------------------------------------------
# API key for authenticating frontend requests (Authorization: Bearer).
# Must match VITE_API_KEY used by the frontend.
# Where: Render = Environment variables
HORAIN_API_KEY=HORAIN_DEV_KEY

# -----------------------------------------------------------------------------
# LLM (assistant) — OpenAI par défaut
# -----------------------------------------------------------------------------
# Sans clé API, l'assistant utilise PlaceholderLlmClient (réponses fixes).
# Avec OPENAI_API_KEY (ou LLM_API_KEY), client RestTemplate (openai-compatible) utilisé
# avec les valeurs par défaut. Autres variables optionnelles pour surcharger.
#
# Requise pour activer le chat réel :
OPENAI_API_KEY=sk-your-openai-api-key
#   (ou LLM_API_KEY=) — https://platform.openai.com/api-keys
#
# Optionnelles (défauts = OpenAI) :
# LLM_API_KEY=                    # Alternative à OPENAI_API_KEY
# LLM_BASE_URL=https://api.openai.com/v1  # OpenRouter : https://openrouter.ai/api/v1
# LLM_MODEL=gpt-4o-mini           # OpenRouter : openai/gpt-4o-mini, anthropic/claude-3-haiku
# LLM_CLIENT=openai-compatible    # défaut | spring-ai
