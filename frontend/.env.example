# =============================================================================
# Horain Frontend - Environment variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Vite only exposes variables prefixed with VITE_ to the client.
#
# Where to configure:
#   - Local dev: copy to .env in this directory
#   - Production (GitHub Pages): GitHub Repository Secrets (see docs/ENV_SETUP.md)
# =============================================================================

# -----------------------------------------------------------------------------
# VITE_API_URL
# -----------------------------------------------------------------------------
# Backend API base URL (no trailing slash).
#   Dev (vide):  utilise /api (proxy Vite → backend). Permet test depuis smartphone.
#   Dev (direct): http://localhost:8080 si tu veux contourner le proxy.
#   Prod:        https://horain.onrender.com (injecté par GitHub Actions)
# Where: Local = .env | GitHub Actions = Repository Secret VITE_API_URL
# Pour test smartphone: laisser vide ou ne pas définir.
VITE_API_URL=

# -----------------------------------------------------------------------------
# VITE_API_KEY
# -----------------------------------------------------------------------------
# API key for Authorization: Bearer header.
# Must match HORAIN_API_KEY on the backend (Render env vars).
# Where: Local = .env | GitHub Actions = Repository Secret VITE_API_KEY
VITE_API_KEY=HORAIN_DEV_KEY

# -----------------------------------------------------------------------------
# VITE_STT_DELAY_MS
# -----------------------------------------------------------------------------
# Artificial delay (ms) before transcription callback, for testing the
# "Transcribing..." UX state in local dev. Set to 0 to disable. Default: 0.
# Example: 2500 to simulate a 2.5s transcription.
VITE_STT_DELAY_MS=0
