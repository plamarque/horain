# Promptfoo eval environment variables.
# Copy to .env or set before running: npx promptfoo eval
#
# HORAIN_API_KEY - API key for backend auth (Authorization: Bearer).
#   Must match backend's horain.api-key (default: HORAIN_DEV_KEY)
#
# OPENAI_API_KEY - Not used by Promptfoo directly; the backend uses it for LLM.
#   Set in backend/.env for the backend to respond to chat requests.

HORAIN_API_KEY=HORAIN_DEV_KEY
